---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Artyfacts - Art open in London",
  description = "A fortnight of London exhibitions, gathered in one place.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eee9df" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://media.tate.org.uk" />
    <link rel="preconnect" href="https://www.whitechapelgallery.org" />
    <link rel="preconnect" href="https://assets-cdn.vam.ac.uk" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
